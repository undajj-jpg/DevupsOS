# Copy to .env.local for development. NEVER commit a filled-in copy —
# CI runs gitleaks and will fail the build (guardrail §3.1).
#
# In production every one of these comes from the secrets manager
# (Doppler / AWS Secrets Manager) or Vercel's encrypted environment store.

# --- required ---------------------------------------------------------------

# Postgres with RLS. Neon, Supabase and Vercel Postgres all work.
# Use the pooled connection string on serverless.
DATABASE_URL=postgres://user:password@host:5432/devups?sslmode=require

# Signs session cookies. >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- scheduling and integrations -------------------------------------------

# Bearer token Vercel Cron sends on each scheduled invocation. Without it the
# cron endpoints refuse to run rather than defaulting to open.
CRON_SECRET=

# Bearer token for the MCP tool surface (§7). Omit to leave MCP disabled.
MCP_TOKEN=

# LLM. Without a key, drafting falls back to templates and reply triage falls
# back to deterministic rules — the app still runs.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Sourcing and verification (Fase 1). Optional until those flows are wired.
ANYMAIL_FINDER_API_KEY=
APOLLO_API_KEY=

# --- behaviour --------------------------------------------------------------

APP_URL=http://localhost:3000

# Pins every agent to suggestion mode regardless of database state. Defaults to
# on; set to exactly "false" to allow autonomy once the §10 gate has passed.
FORCE_SUGGESTION_MODE=true
